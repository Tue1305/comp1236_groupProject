#!/bin/bash

echo "Enter the start of the range (a): "
read a

echo "Enter the end of the range (b): "
read b

# Hexagonal number formula: H(n) = n(2n - 1)

odd_count=0
even_count=0
odd_sum=0
even_sum=0

echo "Hexagonal numbers within [$a, $b]:"

n=1
while true; do
    H=$(( n * (2*n - 1) ))

    if [ $H -gt $b ]; then
        break
    fi

    if [ $H -ge $a ]; then
        if (( H % 2 == 0 )); then
            echo "$H is EVEN"
            even_count=$((even_count + 1))
            even_sum=$((even_sum + H))
        else
            echo "$H is ODD"
            odd_count=$((odd_count + 1))
            odd_sum=$((odd_sum + H))
        fi
    fi

    n=$((n + 1))
done

echo
echo "===== RESULTS ====="
echo "Total odd hexagonal numbers: $odd_count"
echo "Total even hexagonal numbers: $even_count"
echo "Sum of odd hexagonal numbers: $odd_sum"
echo "Sum of even hexagonal numbers: $even_sum"
